# 指向云服务器公网 IP 的域名。没有自有域名时可暂用：公网IP.sslip.io
DOMAIN=demo.example.com

# DeepSeek 凭据和模型。不要把真实 .env 提交到 Git。
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_IMAGE_MODEL=deepseek-v4-flash-vision-exp

# 公网页面的 HTTP Basic Auth 用户名。
DEMO_USERNAME=interviewer

# 使用下面的命令生成，复制结果并保留单引号：
# docker run --rm caddy:2-alpine caddy hash-password --plaintext '你的强密码'
DEMO_PASSWORD_HASH='$2a$14$replace_with_a_real_caddy_password_hash'
